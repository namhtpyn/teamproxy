{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/dev/assets/oh-my-opencode.schema.json",
  "auto_update": true,
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  },
  "hashline_edit": false,
  "new_task_system_enabled": true,
  "start_work": {
    "auto_commit": false
  },
  "team_mode": {
    "max_members": 8,
    "enabled": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  },
  "experimental": {
    "task_system": true
  },
  "agents": {
    "sisyphus": {
      "model": "zai-coding-plan/glm-5.1",
      "temperature": 0
    },
    "oracle": {
      "model": "zai-coding-plan/glm-5.1",
      "temperature": 0
    },
    "librarian": {
      "model": "zai-coding-plan/glm-5.1",
      "temperature": 0
    },
    "explore": {
      "model": "zai-coding-plan/glm-5.1",
      "temperature": 0
    },
    "multimodal-looker": {
      "model": "zai-coding-plan/glm-5.1",
      "temperature": 0
    },
    "prometheus": {
      "model": "zai-coding-plan/glm-5.1",
      "temperature": 0
    },
    "metis": {
      "model": "zai-coding-plan/glm-5.1",
      "temperature": 0
    },
    "momus": {
      "model": "zai-coding-plan/glm-5.1",
      "temperature": 0
    },
    "atlas": {
      "model": "zai-coding-plan/glm-5.1",
      "temperature": 0
    },
    "sisyphus-junior": {
      "model": "zai-coding-plan/glm-5.1",
      "temperature": 0
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "zai-coding-plan/glm-5.1",
      "temperature": 0
    },
    "ultrabrain": {
      "model": "zai-coding-plan/glm-5.1",
      "temperature": 0
    },
    "deep": {
      "model": "zai-coding-plan/glm-5.1",
      "temperature": 0
    },
    "artistry": {
      "model": "zai-coding-plan/glm-5.1",
      "temperature": 0
    },
    "quick": {
