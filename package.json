{
  "name": "team-proxy",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "tmux new -A -s dev-server 'nuxt dev --tunnel'",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@microsoft/microsoft-graph-types": "2.43.1",
    "@nuxt/ui": "4.8.1",
    "@orpc/client": "1.14.4",
    "@orpc/experimental-publisher": "1.14.4",
    "@orpc/experimental-ratelimit": "1.14.4",
    "@orpc/server": "1.14.4",
    "@orpc/tanstack-query": "1.14.4",
    "@tanstack/vue-query": "5.100.14",
    "@vueuse/core": "14.3.0",
    "drizzle-orm": "1.0.0-rc.3",
    "nuxt": "4.4.6",
    "nuxt-easy-lightbox": "1.1.0",
    "tailwindcss": "4.3.0",
    "vue": "3.5.35",
    "vue-router": "5.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.15.2",
    "drizzle-kit": "1.0.0-rc.3",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vue-tsc": "3.3.2",
    "@types/node": "25.9.1"
  }
}
